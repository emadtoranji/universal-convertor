{
  "name": "universal-convertor",
  "version": "1.0.1",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "update": "npx npm-check-updates -u",
    "lint": "eslint src --no-error-on-unmatched-pattern",
    "prettier": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css}\"",
    "test": "node --test --experimental-strip-types tests/**/*.test.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "@webtoon/psd": "^0.4.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.72.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "protobufjs": true,
    "re2": true
  }
}
